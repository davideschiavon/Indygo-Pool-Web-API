// Copy this file to ble_secrets.h (git-ignored) to enable the BLE authentication handshake with
// Solem/Indygo equipment that uses it (observed on a POOL COMMAND VS² / LRPC-VS2; see docs/ble-auth.md).
//
// The key is a 16-byte AES-128 key, shared across devices, embedded in the vendor Android app
// (fr.solem.connected_pool, class BleManager). This project does not publish it: extract it yourself
// from an app you are licensed to use, for interoperability with equipment you own, and keep this
// file out of version control (it already is, via .gitignore).
//
// Format: 32 hex characters (16 bytes), e.g. "00112233445566778899AABBCCDDEEFF" trimmed to 32 chars.
#define BLE_AUTH_KEY_HEX ""
